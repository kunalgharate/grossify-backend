# Server
PORT=3000
NODE_ENV=development
# Number of trusted reverse-proxy hops in front of Express (e.g. 1 for one Nginx/Render proxy).
# Keep 0 when the API is reached directly; configure to match the actual deployment topology.
TRUST_PROXY_HOPS=0

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Valkey (Redis-compatible)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=

# MSG91 (SMS/OTP)
MSG91_AUTH_KEY=xxx
MSG91_SENDER_ID=GROSFY
MSG91_OTP_TEMPLATE_ID=
# Optional public-demo mode: keeps NODE_ENV=production but disables MSG91 and accepts 123456 only for listed phones.
# Anyone who knows a listed number can sign into that demo account. Do not use with real users or data.
# DEMO_OTP_ENABLED=true
# DEMO_OTP_ALLOWED_PHONES=+919000000001,+919000000002,+919000000004,+919000000005

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# App
APP_NAME=Grossify
APP_URL=http://localhost:3000
